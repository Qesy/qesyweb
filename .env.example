APP_NAME=qesyweb
APP_ENV=development
HTTP_ADDR=:8080

LOG_DIR=./logs
LOG_LEVEL=info
LOG_TIMEZONE=Asia/Shanghai
LOG_RETENTION_DAYS=30
LOG_CONSOLE=true
LOG_ADD_SOURCE=false

MYSQL_ENABLED=false
MYSQL_DRIVER=mysql
MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/qesyweb?parseTime=true&charset=utf8mb4
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5

REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
WORKER_ENABLED=true
WORKER_COUNT=2
WORKER_QUEUE_SIZE=32

SESSION_COOKIE_NAME=qesyweb_session
SESSION_TTL_MINUTES=120
SESSION_COOKIE_SECURE=false
RESEND_ENABLED=false
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=QesyWeb <noreply@example.com>
